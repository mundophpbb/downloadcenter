{
	"name": "mundophpbb/downloadcenter",
	"type": "phpbb-extension",
	"description": "A download center for phpBB: categories, versions with changelog, user submissions with moderation, notifications, support topics, screenshots, statistics and secure delivery.",
	"homepage": "https://mundophpbb.com.br",
	"version": "1.3.4",
	"time": "2026-11-11",
	"license": "GPL-2.0-only",
	"authors": [
		{
			"name": "Chico Gois",
			"homepage": "https://mundophpbb.com.br",
			"role": "Developer"
		}
	],
	"require": {
		"php": ">=7.4",
		"composer/installers": "^1.0 || ^2.0"
	},
	"extra": {
		"display-name": "Download Center",
		"soft-require": {
			"phpbb/phpbb": ">=3.3.0,<4.0.0@dev"
		},
		"version-check": {
			"host": "mundophpbb.com.br",
			"directory": "/ext/",
			"filename": "downloadcenter.json",
			"ssl": true
		}
	}
}
